UserInputService.WindowFocused:Connect(function()
    CBF.windowFocused          = true
    CBF.accumulator            = 0
    CBF.focusCooldownRemaining = CFG.CBF.focusCooldown
    CBF.adaptedIntensity       = CBF.intensity
    logInfo(string.format(
        "CBF: window focus restored — cooldown %.2fs before resuming",
        CFG.CBF.focusCooldown
    ))
end)

RunService.Heartbeat:Connect(function(dt)
    if not CBF.enabled or CBF.intensity <= 0 then return end
    if not CBF.windowFocused then return end

    if CBF.focusCooldownRemaining > 0 then
        CBF.focusCooldownRemaining = CBF.focusCooldownRemaining - dt
        return
    end

    if dt > CFG.CBF.dtSpikeThreshold then
        local before = CBF.adaptedIntensity
        CBF.adaptedIntensity  = CBF.adaptedIntensity * CFG.CBF.dtSpikeBackoff
        CBF.accumulator       = 0
        CBF.stats.spikeBackoffs = CBF.stats.spikeBackoffs + 1
        logDebug(string.format(
            "CBF: dt spike %.3fs — intensity %.2f → %.2f",
            dt, before, CBF.adaptedIntensity
        ))
        return
    end

    CBF.adaptedIntensity = math.min(
        CBF.intensity,
        CBF.adaptedIntensity + dt * CFG.CBF.intensityRecoveryRate
    )

    CBF.accumulator = CBF.accumulator + dt

    local targetInterval = cbfTargetInterval()
    if CBF.accumulator >= targetInterval then
        cbfFire()

        local jitter = (math.random() * 2 - 1) * CFG.CBF.jitterMax
        CBF.accumulator = math.max(0, CBF.accumulator - targetInterval + jitter)
    end
end)

