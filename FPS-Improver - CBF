local LevelSoundMirror = {}

local SOUND_PROPERTIES = {
    "SoundId", "Volume", "Pitch", "PlaybackSpeed", "Looped",
    "RollOffMaxDistance", "RollOffMinDistance", "RollOffMode",
    "PlayOnRemove", "TimePosition", "EmitterSize",
}

local function getOrCreateSongFolder()
    local folder = Workspace:FindFirstChild("Song")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "Song"
        folder.Parent = Workspace
    end
    return folder
end

local function getOrCreateMirrorSound(folder)
    local sound = folder:FindFirstChild("Sound")
    if not sound then
        sound = Instance.new("Sound")
        sound.Name = "Sound"
        sound.Parent = folder
    end
    return sound
end

local SKIP_ON_COPY = { TimePosition = true, Volume = true }

local function applyAllProperties(source, target)
    for _, prop in ipairs(SOUND_PROPERTIES) do
        if not SKIP_ON_COPY[prop] then
            local ok, val = pcall(function() return source[prop] end)
            if ok and val ~= nil then
                pcall(function() target[prop] = val end)
            end
        end
    end
end

local function cleanupMirror()
    if LevelSoundMirror.propertyConnections then
        for _, conn in ipairs(LevelSoundMirror.propertyConnections) do
            pcall(function() conn:Disconnect() end)
        end
        LevelSoundMirror.propertyConnections = {}
    end
    if LevelSoundMirror.playConn then
        pcall(function() LevelSoundMirror.playConn:Disconnect() end)
        LevelSoundMirror.playConn = nil
    end
    if LevelSoundMirror.levelSound and LevelSoundMirror.originalVolume then
        pcall(function() LevelSoundMirror.levelSound.Volume = LevelSoundMirror.originalVolume end)
    end
    LevelSoundMirror.levelSound = nil
    LevelSoundMirror.originalVolume = nil
    LevelSoundMirror.paused = false
end

local function destroyMirrorSound()
    cleanupMirror()
    local folder = Workspace:FindFirstChild("Song")
    if folder then
        local sound = folder:FindFirstChild("Sound")
        if sound then
            sound:Destroy()
        end
    end
end

local function watchLevelSound(levelSound)
    cleanupMirror()

    local folder = getOrCreateSongFolder()
    local mirrorSound = getOrCreateMirrorSound(folder)

    applyAllProperties(levelSound, mirrorSound)

    LevelSoundMirror.originalVolume = levelSound.Volume
    LevelSoundMirror.levelSound = levelSound
    pcall(function() mirrorSound.Volume = levelSound.Volume end)
    pcall(function() levelSound.Volume = 0 end)

    LevelSoundMirror.propertyConnections = {}
    for _, prop in ipairs(SOUND_PROPERTIES) do
        if prop ~= "TimePosition" and prop ~= "Volume" then
            local ok, conn = pcall(function()
                return levelSound:GetPropertyChangedSignal(prop):Connect(function()
                    local vok, val = pcall(function() return levelSound[prop] end)
                    if vok then
                        pcall(function() mirrorSound[prop] = val end)
                    end
                end)
            end)
            if ok and conn then
                table.insert(LevelSoundMirror.propertyConnections, conn)
            end
        end
    end

    local volConn = levelSound:GetPropertyChangedSignal("Volume"):Connect(function()
        local vok, val = pcall(function() return levelSound.Volume end)
        if vok and val and val > 0 then
            LevelSoundMirror.originalVolume = val
            pcall(function() mirrorSound.Volume = val end)
            pcall(function() levelSound.Volume = 0 end)
        end
    end)
    table.insert(LevelSoundMirror.propertyConnections, volConn)

    local started = false

    local function kickoffMirror()
        if started then return end
        started = true
        pcall(function()
            mirrorSound.TimePosition = levelSound.TimePosition
            mirrorSound:Play()
        end)
        if LevelSoundMirror.playConn then
            pcall(function() LevelSoundMirror.playConn:Disconnect() end)
            LevelSoundMirror.playConn = nil
        end
    end

    if levelSound.Playing then
        kickoffMirror()
    else
        LevelSoundMirror.playConn = levelSound:GetPropertyChangedSignal("Playing"):Connect(function()
            local ok, playing = pcall(function() return levelSound.Playing end)
            if ok and playing then
                kickoffMirror()
            end
        end)
    end
end

local function setupLevelSoundWatcher()
    local Shared = ReplicatedStorage:WaitForChild("Shared")
    local Classes = Shared:WaitForChild("Classes")
    local Level = Classes:WaitForChild("Level")

    local function onSoundAdded(sound)
        if sound.Name ~= "Sound" then return end
        logInfo("[LevelSoundMirror] Level.Sound found — setting up mirror")
        watchLevelSound(sound)

        sound.AncestryChanged:Connect(function(_, parent)
            if not parent then
                logInfo("[LevelSoundMirror] Level.Sound removed — cleaning up")
                cleanupMirror()
            end
        end)
    end

    local existing = Level:FindFirstChild("Sound")
    if existing then
        onSoundAdded(existing)
    end

    Level.ChildAdded:Connect(function(child)
        onSoundAdded(child)
    end)
end

task.spawn(function()
    local ok, err = pcall(setupLevelSoundWatcher)
    if not ok then
        logWarn("[LevelSoundMirror] Failed to set up watcher:", err)
    end
end)

