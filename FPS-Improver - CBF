local CBF = {
    enabled          = true,
    intensity        = CFG.CBF.intensity,
    baseFrequency    = CFG.CBF.baseFrequency,
    adaptedIntensity = CFG.CBF.intensity,

    accumulator            = 0,
    windowFocused          = true,
    focusCooldownRemaining = 0,

    callbacks = {},

    stats = {
        fires         = 0,
        focusPauses   = 0,
        spikeBackoffs = 0,
        lastFireTime  = 0,
    },
}

local function cbfTargetInterval()
    local eff = CBF.adaptedIntensity
    if eff <= 0 then return math.huge end
    return math.clamp(
        1 / (CBF.baseFrequency * eff),
        CFG.CBF.MIN_INTERVAL,
        CFG.CBF.MAX_INTERVAL
    )
end

function CBF.registerCallback(fn)
    assert(type(fn) == "function", "CBF.registerCallback: argument must be a function")
    table.insert(CBF.callbacks, fn)
    logDebug("CBF: callback registered, total =", #CBF.callbacks)
end

local function cbfFire()
    CBF.stats.fires        = CBF.stats.fires + 1
    CBF.stats.lastFireTime = os.clock()
    logDebug("CBF fire #" .. CBF.stats.fires)

    for _, fn in ipairs(CBF.callbacks) do
        local ok, err = pcall(fn)
        if not ok then
            logWarn("CBF callback error:", err)
        end
    end
end

