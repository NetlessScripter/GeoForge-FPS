local objectCache       = {}
local currentRenderDist = isMobile and CFG.RENDER_DIST.MEDIUM or CFG.RENDER_DIST.HIGH
local smoothFPS         = 60

local function createCache(model)
    if objectCache[model] then return end

    local prim
    local ok = pcall(function()
        prim = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
    end)
    if not ok or not prim then
        logDebug("createCache: skipped (no BasePart) —", model:GetFullName())
        return
    end

    local cache = {
        primaryPart            = prim,
        parts                  = {},
        originalTransparencies = {},
        particles              = {},
        lights                 = {},
        effects                = {},
        lodLevel               = 1,
    }

    for _, v in ipairs(model:GetDescendants()) do
        if v:IsA("BasePart") then
            table.insert(cache.parts, v)
            table.insert(cache.originalTransparencies, v.Transparency)
        elseif v:IsA("ParticleEmitter") then
            table.insert(cache.particles, v)
        elseif v.ClassName:match("Light$") then
            table.insert(cache.lights, v)
        elseif v:IsA("Beam") or v:IsA("Trail") then
            table.insert(cache.effects, v)
        end
    end

    objectCache[model] = cache
    logDebug("createCache: registered", model.Name)
end

local function destroyCache(model)
    if objectCache[model] then
        objectCache[model] = nil
        logDebug("destroyCache:", tostring(model))
    end
end

local function applyLOD(cache, distance)
    if not cache.primaryPart or not cache.primaryPart.Parent then return end

    local newLOD
    if      distance > currentRenderDist          then newLOD = 4
    elseif  distance > currentRenderDist * 0.7    then newLOD = 3
    elseif  distance > currentRenderDist * 0.4    then newLOD = 2
    else                                               newLOD = 1
    end

    if newLOD == cache.lodLevel then return end
    cache.lodLevel = newLOD

    local visible  = (newLOD == 1)
    local shadows  = visible and (not isMobile)
    local effects  = (newLOD == 1)

    for i, part in ipairs(cache.parts) do
        part.Transparency = visible and cache.originalTransparencies[i] or 1
        part.CastShadow   = shadows
    end
    for _, p in ipairs(cache.particles) do p.Enabled = effects end
    for _, l in ipairs(cache.lights)    do l.Enabled = effects end
    for _, e in ipairs(cache.effects)   do e.Enabled = effects end
end

local lodAccumulator = 0

RunService.Heartbeat:Connect(function(dt)

    local instantFPS = (dt > 0) and (1 / dt) or smoothFPS
    smoothFPS = smoothFPS * 0.9 + instantFPS * 0.1

    if smoothFPS < 40 then

        currentRenderDist = math.max(CFG.RENDER_DIST.POTATO, currentRenderDist * 0.97)
        Lighting.GlobalShadows = false
        logDebug(string.format("LOD: FPS=%.0f — contracting renderDist to %.0f", smoothFPS, currentRenderDist))
    elseif smoothFPS > 100 and currentRenderDist < CFG.RENDER_DIST.HIGH then
        currentRenderDist = math.min(CFG.RENDER_DIST.HIGH, currentRenderDist * 1.02)
    end

    lodAccumulator = lodAccumulator + dt
    if lodAccumulator < CFG.LOD_UPDATE_INTERVAL then return end
    lodAccumulator = 0

    local cam = Workspace.CurrentCamera
    if not cam then return end
    local camPos = cam.CFrame.Position

    for model, cache in pairs(objectCache) do
        if model and model.Parent then
            if cache.primaryPart and cache.primaryPart.Parent then
                applyLOD(cache, (cache.primaryPart.Position - camPos).Magnitude)
            else
                destroyCache(model)
            end
        else
            destroyCache(model)
        end
    end
end)

