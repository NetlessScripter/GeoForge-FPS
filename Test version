local FPS = {
    window       = table.create(CFG.FPS.SAMPLE_WINDOW, 1/60),
    writeIdx     = 1,
    filled       = false,

    fastEMA      = 60,
    slowEMA      = 60,
    current      = 60,

    p5           = 60,
    p50          = 60,
    p95          = 60,

    spikesPerSec = 0,
    _spikeCount  = 0,
    _spikeTimer  = 0,
    _pctTimer    = 0,
}

local _sortBuf = table.create(CFG.FPS.SAMPLE_WINDOW)

local function fpsUpdate(dt)
    local safeDt = math.clamp(dt, 0.001, 0.5)
    local fps    = 1 / safeDt

    FPS.window[FPS.writeIdx] = safeDt
    FPS.writeIdx = (FPS.writeIdx % CFG.FPS.SAMPLE_WINDOW) + 1
    if FPS.writeIdx == 1 then FPS.filled = true end

    FPS.fastEMA = FPS.fastEMA * (1 - CFG.FPS.EMA_FAST) + fps * CFG.FPS.EMA_FAST
    FPS.slowEMA = FPS.slowEMA * (1 - CFG.FPS.EMA_SLOW) + fps * CFG.FPS.EMA_SLOW
    FPS.current = FPS.fastEMA

    FPS._pctTimer = FPS._pctTimer + 1
    if FPS._pctTimer >= 10 then
        FPS._pctTimer = 0
        local n = FPS.filled and CFG.FPS.SAMPLE_WINDOW or math.max(FPS.writeIdx - 1, 1)
        for i = 1, n do
            _sortBuf[i] = 1 / math.max(FPS.window[i], 0.001)
        end
        table.sort(_sortBuf, function(a, b) return a < b end)
        FPS.p5  = _sortBuf[math.max(1, math.floor(n * 0.05))]
        FPS.p50 = _sortBuf[math.floor(n * 0.50)]
        FPS.p95 = _sortBuf[math.min(n, math.ceil(n * 0.95))]
    end

    if dt > CFG.FPS.SPIKE_THRESHOLD then FPS._spikeCount = FPS._spikeCount + 1 end
    FPS._spikeTimer = FPS._spikeTimer + dt
    if FPS._spikeTimer >= 1 then
        FPS.spikesPerSec = FPS._spikeCount
        FPS._spikeCount  = 0
        FPS._spikeTimer  = FPS._spikeTimer - 1
    end
end

local QC = {
    level       = CFG.QUALITY.INITIAL_LEVEL,
    forcedLevel = nil,

    sustainTimer     = 0,
    evalAccumulator  = 0,
    emergencyCooldown = 0,

    stats = { increases=0, decreases=0, emergency=0 },
}

local function applyQualityTier(level)
    local lv   = math.clamp(math.round(level), 1, CFG.QUALITY.LEVELS)
    local tier = CFG.QUALITY.TIERS[lv]
    if not tier then return end

    currentRenderDist = tier.dist

    pcall(function() Lighting.GlobalShadows = tier.shadows end)
    pcall(function() Lighting.ShadowSoftness = tier.shadowSoft end)

    pcall(function()
        local rQL = math.clamp(math.round((lv / CFG.QUALITY.LEVELS) * 21), 1, 21)
        settings().Rendering.QualityLevel = rQL
    end)

    logDebug(string.format(
        "QC: tier=%d dist=%d shadows=%s shadowSoft=%.1f particles=%.0f%% lights=%d effects=%s",
        lv, tier.dist, tostring(tier.shadows), tier.shadowSoft,
        tier.particles * 100, tier.lights, tostring(tier.effects)
    ))
end

local function qcEvaluate(dt)
    if QC.forcedLevel then
        if QC.level ~= QC.forcedLevel then
            QC.level = QC.forcedLevel
            applyQualityTier(QC.level)
        end
        return
    end

    QC.emergencyCooldown = math.max(0, QC.emergencyCooldown - dt)

    if FPS.current < CFG.FPS.CRITICAL and QC.emergencyCooldown <= 0 then
        local before = QC.level
        QC.level = math.max(1, math.floor(QC.level * CFG.QUALITY.MULT_DROP))
        QC.emergencyCooldown = CFG.QUALITY.EMERGENCY_COOLDOWN
        QC.stats.emergency   = QC.stats.emergency + 1
        applyQualityTier(QC.level)
        logInfo(string.format("QC EMERGENCY: %d → %d (FPS=%.0f)", before, QC.level, FPS.current))
        return
    end

    QC.evalAccumulator = QC.evalAccumulator + dt
    if QC.evalAccumulator < CFG.QUALITY.EVAL_INTERVAL then return end
    QC.evalAccumulator = QC.evalAccumulator - CFG.QUALITY.EVAL_INTERVAL

    if FPS.p5 < CFG.QUALITY.STEP_DOWN_THRESHOLD and QC.level > 1 then
        local before = QC.level
        QC.level       = QC.level - 1
        QC.sustainTimer = 0
        QC.stats.decreases = QC.stats.decreases + 1
        applyQualityTier(QC.level)
        logInfo(string.format("QC step DOWN: %d → %d (p5=%.0f)", before, QC.level, FPS.p5))

    elseif FPS.slowEMA > CFG.QUALITY.STEP_UP_THRESHOLD and QC.level < CFG.QUALITY.LEVELS then
        QC.sustainTimer = QC.sustainTimer + CFG.QUALITY.EVAL_INTERVAL
        if QC.sustainTimer >= CFG.QUALITY.STEP_UP_SUSTAIN then
            local before = QC.level
            QC.level        = QC.level + 1
            QC.sustainTimer = 0
            QC.stats.increases = QC.stats.increases + 1
            applyQualityTier(QC.level)
            logInfo(string.format("QC step UP: %d → %d (slowEMA=%.0f)", before, QC.level, FPS.slowEMA))
        end
    else
        QC.sustainTimer = 0
    end
end

local Budget = {
    lod=0,  cbf=0,  qc=0,  total=0,
    lod_s=0, cbf_s=0, qc_s=0, total_s=0,
    _EMA = 0.10,
}

local function budgetUpdate(cat, delta)
    Budget[cat]         = delta
    local key           = cat .. "_s"
    Budget[key]         = Budget[key] * (1 - Budget._EMA) + delta * Budget._EMA
end

local objectCache    = {}
local lodAccumulator = 0
local lodBatchIdx    = 1
local lodModelList   = {}

local function createCache(model)
    if objectCache[model] then return end
    local prim
    local ok = pcall(function()
        prim = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
    end)
    if not ok or not prim then
        logDebug("createCache: skip (no BasePart) —", model:GetFullName())
        return
    end

    local cache = {
        primaryPart = prim,
        parts       = {}, origTrans = {},
        particles   = {}, origRates = {},
        lights      = {},
        effects     = {},
        lodLevel    = 0,
        lastDist    = 0,
    }

    for _, v in ipairs(model:GetDescendants()) do
        if v:IsA("BasePart") then
            table.insert(cache.parts, v)
            table.insert(cache.origTrans, v.Transparency)
        elseif v:IsA("ParticleEmitter") then
            table.insert(cache.particles, v)
            table.insert(cache.origRates, v.Rate)
        elseif v.ClassName:match("Light$") then
            table.insert(cache.lights, v)
        elseif v:IsA("Beam") or v:IsA("Trail") then
            table.insert(cache.effects, v)
        end
    end

    objectCache[model] = cache
end

local function destroyCache(model)
    objectCache[model] = nil
end

local function lodLevelForDist(normDist, currentLOD)
    local targetLOD = 1
    local levels    = CFG.LOD.LEVELS
    for lv = 6, 1, -1 do
        if normDist >= levels[lv].thresh then
            targetLOD = lv + 1
            break
        end
    end
    targetLOD = math.clamp(targetLOD, 1, 6)

    if targetLOD < currentLOD then
        local improveTh = CFG.LOD.IMPROVE_THRESH[currentLOD] or 0
        if normDist > improveTh then
            return currentLOD
        end
    end

    return targetLOD
end

local function applyLOD(cache, distance)
    if not cache.primaryPart or not cache.primaryPart.Parent then return end

    local normDist = distance / math.max(currentRenderDist, 1)
    local newLOD   = lodLevelForDist(normDist, cache.lodLevel)
    if newLOD == cache.lodLevel then return end
    cache.lodLevel = newLOD
    cache.lastDist = distance

    local lodCfg = CFG.LOD.LEVELS[newLOD]
    local tier   = CFG.QUALITY.TIERS[math.clamp(QC.level, 1, CFG.QUALITY.LEVELS)]

    local shadowsAllowed = lodCfg.shadows and tier.shadows and not isMobile
    for i, part in ipairs(cache.parts) do
        part.Transparency = math.clamp(math.max(cache.origTrans[i], lodCfg.trans), 0, 1)
        part.CastShadow   = shadowsAllowed
    end

    local particlesOn = lodCfg.particles and (tier.particles > 0)
    for i, p in ipairs(cache.particles) do
        p.Enabled = particlesOn
        if particlesOn then
            pcall(function() p.Rate = cache.origRates[i] * tier.particles end)
        end
    end

    local lightsOn = lodCfg.lights and (distance < tier.lights)
    for _, l in ipairs(cache.lights) do l.Enabled = lightsOn end

    local effectsOn = lodCfg.effects and tier.effects
    for _, e in ipairs(cache.effects) do e.Enabled = effectsOn end
end

RunService.Heartbeat:Connect(function(dt)
    local t0 = os.clock()

    fpsUpdate(dt)

    local t1 = os.clock()
    qcEvaluate(dt)
    budgetUpdate("qc", os.clock() - t1)

    lodAccumulator = lodAccumulator + dt
    if lodAccumulator >= CFG.LOD.UPDATE_INTERVAL then
        lodAccumulator = lodAccumulator - CFG.LOD.UPDATE_INTERVAL

        local cam = Workspace.CurrentCamera
        if cam then
            local camPos = cam.CFrame.Position

            lodModelList = {}
            for model in pairs(objectCache) do
                if model and model.Parent then
                    table.insert(lodModelList, model)
                end
            end

            local tLOD = os.clock()
            local n    = #lodModelList
            if n > 0 then
                local batchEnd = math.min(lodBatchIdx + CFG.LOD.BATCH_SIZE - 1, n)
                for i = lodBatchIdx, batchEnd do
                    local model = lodModelList[i]
                    local cache = objectCache[model]
                    if cache then
                        if cache.primaryPart and cache.primaryPart.Parent then
                            applyLOD(cache, (cache.primaryPart.Position - camPos).Magnitude)
                        else
                            destroyCache(model)
                        end
                    end
                end
                lodBatchIdx = batchEnd >= n and 1 or (batchEnd + 1)
            end
            budgetUpdate("lod", os.clock() - tLOD)
        end
    end

    budgetUpdate("total", os.clock() - t0)
end)

local CBF = {
    enabled          = true,
    intensity        = CFG.CBF.intensity,
    baseFrequency    = CFG.CBF.baseFrequency,
    adaptedIntensity = CFG.CBF.intensity,

    timeSinceLastFire      = 0,
    windowFocused          = true,
    focusCooldownRemaining = 0,

    callbacks       = { {}, {}, {}, {} },
    legacyCallbacks = {},

    stats = {
        fires=0, catchupFires=0, burstFires=0,
        focusPauses=0, spikeBackoffs=0,
        lastFireTime=0, totalCallbackMs=0,
    },
}

local function cbfTargetInterval()
    local eff = CBF.adaptedIntensity
    if eff <= 0 then return math.huge end
    return math.clamp(
        1 / (CBF.baseFrequency * eff),
        CFG.CBF.MIN_INTERVAL,
        CFG.CBF.MAX_INTERVAL
    )
end

local function cbfExecute()
    local t0 = os.clock()
    CBF.stats.fires        = CBF.stats.fires + 1
    CBF.stats.lastFireTime = t0

    for priority = 1, 4 do
        for _, entry in ipairs(CBF.callbacks[priority]) do
            local ok, err = pcall(entry.fn)
            if not ok then logWarn("CBF[" .. priority .. "] error:", err) end
        end
    end
    for _, fn in ipairs(CBF.legacyCallbacks) do
        local ok, err = pcall(fn)
        if not ok then logWarn("CBF legacy error:", err) end
    end

    local elapsed = (os.clock() - t0) * 1000
    CBF.stats.totalCallbackMs = CBF.stats.totalCallbackMs + elapsed
    budgetUpdate("cbf", elapsed / 1000)
end

function CBF.registerCallback(fn, priority)
    assert(type(fn) == "function", "CBF.registerCallback: function expected")
    if not priority or priority < 1 or priority > 4 then
        table.insert(CBF.legacyCallbacks, fn)
    else
        table.insert(CBF.callbacks[priority], { fn = fn })
    end
end

function CBF.burst(count)
    count = math.clamp(count or 1, 1, 10)
    for i = 1, count do
        cbfExecute()
        CBF.stats.burstFires = CBF.stats.burstFires + 1
    end
    CBF.timeSinceLastFire = 0
    logDebug("CBF burst ×" .. count)
end

