local function applyPreset(name)
    local p = PRESETS[name:upper()]
    if not p then logWarn("Unknown preset:", name) return end
    QC.forcedLevel    = p.fixed and p.level or nil
    QC.level          = p.level
    CBF.baseFrequency = p.cbfHz
    applyQualityTier(p.level)
    logInfo(string.format("Preset '%s': %s", name, p.desc))
end

