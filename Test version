local _cbfEvent = CFG.CBF.USE_PRERENDER and RunService.PreRender or RunService.Heartbeat

_cbfEvent:Connect(function(dt)
    if not CBF.enabled or CBF.intensity <= 0 then return end
    if not CBF.windowFocused then return end

    if CBF.focusCooldownRemaining > 0 then
        CBF.focusCooldownRemaining = CBF.focusCooldownRemaining - dt
        return
    end

    if dt > CFG.CBF.SPIKE_THRESHOLD then
        CBF.adaptedIntensity  = CBF.adaptedIntensity * CFG.CBF.SPIKE_BACKOFF
        CBF.timeSinceLastFire = 0
        CBF.stats.spikeBackoffs = CBF.stats.spikeBackoffs + 1
        logDebug(string.format("CBF spike %.3fs → intensity %.2f", dt, CBF.adaptedIntensity))
        return
    end

    CBF.adaptedIntensity = math.min(
        CBF.intensity,
        CBF.adaptedIntensity + dt * CFG.CBF.INTENSITY_RECOVERY
    )

    CBF.timeSinceLastFire = CBF.timeSinceLastFire + dt

    local interval   = cbfTargetInterval()
    local firesOwed  = math.floor(CBF.timeSinceLastFire / interval)
    if firesOwed <= 0 then return end

    local toFire  = math.min(firesOwed, CFG.CBF.MAX_CATCHUP)
    local catchup = toFire - 1

    local jitter = (math.random() * 2 - 1) * CFG.CBF.JITTER_MAX

    for i = 1, toFire do
        cbfExecute()
    end

    if catchup > 0 then
        CBF.stats.catchupFires = CBF.stats.catchupFires + catchup
    end

    CBF.timeSinceLastFire = math.max(0, CBF.timeSinceLastFire - firesOwed * interval + jitter)
end)

